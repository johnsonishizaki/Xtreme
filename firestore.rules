rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read and write access for all school duty components and houses
    match /{document=**} {
      allow read, write: if true;
    }
    
    // Explicit collection matches for query compatibility
    match /settings/{settingId} {
      allow read, write: if true;
    }

    match /rosters/{rosterId} {
      allow read, write: if true;
    }

    match /dutyAssignments/{assignmentId} {
      allow read, write: if true;
    }

    match /sendHistory/{historyId} {
      allow read, write: if true;
    }

    match /houses/{houseId} {
      allow read, write: if true;
    }

    match /terms/{termId} {
      allow read, write: if true;
    }

    match /houseReports/{reportId} {
      allow read, write: if true;
    }

    match /notificationSubscriptions/{subId} {
      allow read, write: if true;
    }

    match /tallySubmissions/{submissionId} {
      allow read, write: if true;
    }

    match /tallySyncLogs/{logId} {
      allow read, write: if true;
    }

    match /googleFormsSubmissions/{submissionId} {
      allow read, write: if true;
    }
  }
}
