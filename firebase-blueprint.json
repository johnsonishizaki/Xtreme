{
  "entities": {
    "Settings": {
      "collection": "settings",
      "fields": {
        "reminderEnabled": { "type": "boolean", "description": "Whether scheduled duty reminders are enabled" },
        "reminderDay": { "type": "number", "description": "Day of week for reminder (0 = Sunday .. 6 = Saturday)" },
        "reminderTime": { "type": "string", "description": "Time of day (e.g. 08:00)" },
        "autoAnnounceEnabled": { "type": "boolean", "description": "Whether automated weekly announcement staging & prompt is enabled" },
        "autoCopyOnSchedule": { "type": "boolean", "description": "Whether scheduled announcements auto-copy to clipboard" },
        "messageTemplate": { "type": "string", "description": "WhatsApp announcement template with variables" },
        "whatsAppBehavior": { "type": "string", "description": "Deep link action (app, web, universal)" },
        "aiPersona": { "type": "string", "description": "Selected AI persona preset: concise, supportive, detailed" },
        "activeTermId": { "type": "string", "description": "Active academic term or mid-term ID" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" }
      }
    },
    "AcademicTerm": {
      "collection": "terms",
      "fields": {
        "id": { "type": "string", "description": "Unique term or mid-term ID" },
        "academicYear": { "type": "string", "description": "Academic year e.g. 2026/2027" },
        "termName": { "type": "string", "description": "Term or Mid-Term label (e.g. Term 1, Mid-Term 1)" },
        "termType": { "type": "string", "description": "Period type: term or midterm" },
        "openingDate": { "type": "string", "description": "Opening/return date YYYY-MM-DD" },
        "reportingStartDate": { "type": "string", "description": "Reporting window start YYYY-MM-DD" },
        "reportingEndDate": { "type": "string", "description": "Reporting window end YYYY-MM-DD" },
        "status": { "type": "string", "description": "open or closed" }
      }
    },
    "House": {
      "collection": "houses",
      "fields": {
        "id": { "type": "string", "description": "Unique house identifier (house-1..house-8)" },
        "name": { "type": "string", "description": "House display name" },
        "category": { "type": "string", "description": "Boys or Girls" },
        "assignedHouseparent": { "type": "string", "description": "Houseparent name" },
        "houseparentPhone": { "type": "string", "description": "Optional WhatsApp contact number" },
        "expectedStudentCount": { "type": "number", "description": "Student quota" },
        "active": { "type": "boolean", "description": "Whether house is active" },
        "displayOrder": { "type": "number", "description": "Sort order" }
      }
    },
    "HouseDailyReport": {
      "collection": "houseReports",
      "fields": {
        "id": { "type": "string", "description": "YYYY-MM-DD_houseId" },
        "termId": { "type": "string", "description": "Academic term ID" },
        "reportingDate": { "type": "string", "description": "Date YYYY-MM-DD" },
        "houseId": { "type": "string", "description": "House ID" },
        "houseName": { "type": "string", "description": "House display name" },
        "expectedCount": { "type": "number", "description": "House quota" },
        "reportedCount": { "type": "number", "description": "Students present count" },
        "notReportedCount": { "type": "number", "description": "Pending student count" },
        "notReportedDetails": { "type": "string", "description": "Follow-up notes" },
        "status": { "type": "string", "description": "Report status" }
      }
    },
    "Roster": {
      "collection": "rosters",
      "fields": {
        "name": { "type": "string", "description": "File or source name" },
        "sourceType": { "type": "string", "description": "excel, csv, pdf, sheets, sample" },
        "totalWeeks": { "type": "number", "description": "Number of weeks parsed" },
        "uploadedAt": { "type": "string", "description": "ISO timestamp" },
        "isActive": { "type": "boolean", "description": "Whether this roster is active" }
      }
    },
    "DutyAssignment": {
      "collection": "dutyAssignments",
      "fields": {
        "rosterId": { "type": "string", "description": "Associated roster ID" },
        "weekLabel": { "type": "string", "description": "Human readable week range (e.g. 21-27 September 2026)" },
        "startDate": { "type": "string", "description": "ISO YYYY-MM-DD" },
        "endDate": { "type": "string", "description": "ISO YYYY-MM-DD" },
        "teachers": { "type": "array", "description": "Array of teacher objects with name and role" },
        "dutyTitle": { "type": "string", "description": "Duty role or description" },
        "status": { "type": "string", "description": "confirmed, needs_review" },
        "confidence": { "type": "string", "description": "high, review_needed" },
        "createdAt": { "type": "string", "description": "ISO timestamp" },
        "updatedAt": { "type": "string", "description": "ISO timestamp" }
      }
    },
    "SendHistory": {
      "collection": "sendHistory",
      "fields": {
        "assignmentId": { "type": "string", "description": "Target duty assignment ID" },
        "weekLabel": { "type": "string", "description": "Duty week label" },
        "dutyPeriod": { "type": "string", "description": "Formatted dates" },
        "message": { "type": "string", "description": "Announcement text" },
        "timestamp": { "type": "string", "description": "ISO timestamp of copy / send" },
        "status": { "type": "string", "description": "copied, sent_confirmed" }
      }
    },
    "GoogleFormsSubmission": {
      "collection": "googleFormsSubmissions",
      "fields": {
        "submissionId": { "type": "string", "description": "Unique Google Forms response identifier" },
        "reportId": { "type": "string", "description": "Associated house daily report ID" },
        "houseId": { "type": "string", "description": "OLAG house ID" },
        "houseName": { "type": "string", "description": "OLAG house name" },
        "reportingDate": { "type": "string", "description": "Date YYYY-MM-DD" },
        "reportedCount": { "type": "number", "description": "Students present count" },
        "newArrivalsCount": { "type": "number", "description": "New arrivals count" },
        "receivedAt": { "type": "string", "description": "ISO timestamp received" },
        "status": { "type": "string", "description": "imported or rejected" }
      }
    },
    "AiChatSession": {
      "collection": "aiChats",
      "fields": {
        "id": { "type": "string", "description": "Unique chat session ID" },
        "title": { "type": "string", "description": "Conversation title" },
        "messages": { "type": "array", "description": "Ordered user and AI turns with charts and actions" },
        "createdAt": { "type": "string", "description": "ISO timestamp" },
        "updatedAt": { "type": "string", "description": "ISO timestamp" }
      }
    }
  }
}
